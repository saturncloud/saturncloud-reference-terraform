{
  "controller": {
    "nodeSelector": {
      "node.saturncloud.io/role": "system"
    },
    "tolerations": [
      {
        "key": "node.saturncloud.io/role",
        "operator": "Equal",
        "value": "system",
        "effect": "NoSchedule"
      },
      {
        "key": "CriticalAddonsOnly",
        "operator": "Exists"
      },
      {
        "operator": "Exists",
        "effect": "NoExecute"
      }
    ]
  },
  "node": {
    "tolerations": [
      {
        "effect": "NoSchedule",
        "operator": "Exists"
      },
      {
        "key": "CriticalAddonsOnly",
        "operator": "Exists"
      },
      {
        "operator": "Exists",
        "effect": "NoExecute"
      }
    ]
  }
}

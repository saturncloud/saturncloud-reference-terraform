resource "aws_security_group" "system_nodes" {
  name        = "${var.cluster_name}-system-nodes"
  description = "Group for targeting traffic from system nodes"
  vpc_id      = var.vpc_id

  tags = merge(
    {
      Name = "${var.cluster_name}-system-nodes"
    }, var.tags)

  // EKS worker security group auto-generated by terraform-aws-eks covers
  // all current rules for system node. This group is effectively just for
  // referencing in other security groups. ALLOW ALL egress rule included
  // just so it's not completely empty.
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_security_group_rule" "k8s_api_cidrs" {
  count             = length(var.k8s_api_allowed_cidrs) > 0 ? 1 : 0
  type              = "ingress"
  from_port         = 443
  to_port           = 443
  protocol          = "tcp"
  cidr_blocks       = var.k8s_api_allowed_cidrs
  security_group_id = module.saturn-cluster.cluster_security_group_id
}

resource "aws_security_group_rule" "k8s_api_security_groups" {
  for_each                 = toset(var.k8s_api_allowed_security_group_ids)
  type                     = "ingress"
  from_port                = 443
  to_port                  = 443
  protocol                 = "tcp"
  source_security_group_id = each.key
  security_group_id        = module.saturn-cluster.cluster_security_group_id
}
